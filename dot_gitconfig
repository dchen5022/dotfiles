[user]
    name = Dennis Chen
    email = dechen@redhat.com
[push]
	autoSetupRemote = true
	rebase = true
[init]
	defaultBranch = main
[core]
	autocrlf = input
    eol = lf
	pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    side-by-side = true

[pull]
	rebase = true
[rerere]
	enabled = true
[merge]
    conflictStyle = zdiff3

[alias]
    slog = log --oneline
    fpush = push --force-with-lease
    rba = rebase --abort
    rbc = rebase --continue
    fix = commit -a --amend --no-edit
	summary = show -s --format=%s
	date = show -s --format=%cd
	tag-date = tag -l --format='%(creatordate:iso)'
	rlog = log --oneline --reverse --no-merges --no-abbrev-commit --no-decorate --follow
	amc = am --continue
	ama = am --abort

[sendemail]
    chainreplyto = true
    smtpserver = smtp.corp.redhat.com
    confirm=auto
	suppresscc = body

[includeIf "gitdir:~/School/"]
    path = ~/.gitconfig-school

[includeIf "gitdir:~/LRL/"]
    path = ~/.gitconfig-lrl

[includeIf "gitdir:~/redhat/"]
    path = ~/.redhat.gitconfig


